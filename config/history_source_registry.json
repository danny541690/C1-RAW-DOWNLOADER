{
  "schema_version": "C1-0.93-history-1",
  "objective": "MAX_AVAILABLE_HISTORY_WITH_POINT_IN_TIME_PROVENANCE",
  "history_policy": {
    "global_discovery_floor": "1990-01-01",
    "end_date": "latest_published",
    "never_infer_absence_from_failed_request": true,
    "retain_delisted": true,
    "retain_emerging_raw_only": true,
    "source_raw_immutable": true,
    "raw_and_adjusted_prices_separate": true,
    "publication_time_required_for_pit": true,
    "unknown_pit_label": "PIT_UNVERIFIED",
    "original_and_revised_filings_separate": true,
    "do_not_merge_unverified_old_versions": true
  },
  "sources": [
