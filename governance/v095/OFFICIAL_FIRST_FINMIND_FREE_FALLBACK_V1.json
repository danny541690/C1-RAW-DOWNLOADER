      "DATE_MISMATCH",
      "NON_TRADING_DAY",
      "NOT_YET_PUBLISHED",
      "OFFICIAL_DATA_NOT_OFFERED"
    ],
    "rate_limit_429": "RESPECT_RETRY_AFTER_AND_PAUSE_SOURCE; DO_NOT_CONSUME_RAPID_RETRIES",
    "on_exhausted": "UNRESOLVED_OFFICIAL_DOWNLOAD_NOT_AUTOMATICALLY_PROVEN_MISSING"
  },
  "calendar": {
    "rule": "USE_SOURCE_SPECIFIC_PUBLICATION_CALENDAR",
    "non_trading_day_status": "EXPECTED_NO_DATA",
    "disclosure_not_due_status": "NOT_YET_PUBLISHED"
  },
  "finmind_free": {
    "enabled": true,
    "never_auto_replace_official": true,
    "require": [
      "OFFICIAL_MISSING_CONFIRMED_NOT_ONLY_NETWORK_ERROR",
