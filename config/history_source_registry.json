  "execution": {
    "backfill_order": [
      "2010-2023",
      "2025-latest",
      "1990-2009"
    ],
    "batch_unit": "source_dataset_year_month",
    "max_source_requests_per_unit": 4,
    "successful_unit_never_refetch": true,
    "checkpoint_on_drive": true,
    "failures_deferred": true,
    "rate_limit_policy": "respect_provider_limits_no_bypass",
    "incremental_daily": true,
    "periodic_revision_scan": true,
    "bulk_first": true,
    "financial_budget_policy": "FREE_FIRST_PAID_ONLY_AFTER_REQUEST_VOLUME_ESTIMATE",
    "launch_history_backfill_automatically": false
  },
  "storage": {
    "raw_path": "01_RAW/{year}/{source}/{YYYY-MM}",
    "history_manifest": "00_CONTROL/history_source_registry.json",
    "quality_states": [
      "NOT_YET_PUBLISHED",
      "NOT_LISTED",
      "MARKET_CLOSED",
      "NOT_AVAILABLE_FROM_SOURCE",
      "DEFERRED_MISSING",
      "SOURCE_HOLD",
      "SAVED_BASIC_VALID",
      "PIT_UNVERIFIED",
      "QA_VERIFIED"
    ],
    "money_display_unit": "NTD_100_MILLION"
  },
  "notes": [
    "Documented start is NOT confirmed free API reachability or all-ticker coverage.",
    "Existing 2024 capture remains independent; do not interrupt or replace.",
    "Do not mark complete until actual stock universe, delisted securities, PIT and data quality are verified."
  ]
}
