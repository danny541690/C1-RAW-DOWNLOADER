    "global_source_throttle": "SHARED_HOURLY_COUNTER_REQUIRED_ACROSS_ALL_RUNNERS",
    "source_label": "FINMIND_FREE_FALLBACK",
    "allowed_data_license": "NONCOMMERCIAL_ONLY"
